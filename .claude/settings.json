{
  "permissions": {
    "allow": [
      "Bash(npm install *)",
      "Bash(npm run *)",
      "Bash(mkdir *)",
      "Bash(ls *)",
      "Bash(cat *)",
      "Bash(cd *)",
      "Bash(curl *)",
      "Bash(bash scripts/call-dispatcher.sh *)",
      "Bash(bash scripts/sync-bound-scripts.sh *)",
      "Bash(bash scripts/register-sheet-script.sh *)",
      "mcp__Claude_Code_Remote",
      "mcp__Claude_Code_Remote__add_repo",
      "mcp__Claude_Code_Remote__register_repo_root",
      "mcp__Claude_Code_Remote__list_repos",
      "mcp__Claude_Code_Remote__list_environments",
      "mcp__Claude_Code_Remote__create_trigger",
      "mcp__Claude_Code_Remote__delete_trigger",
      "mcp__Claude_Code_Remote__update_trigger",
      "mcp__Claude_Code_Remote__fire_trigger",
      "mcp__Claude_Code_Remote__list_triggers",
      "mcp__Claude_Code_Remote__send_later",
      "mcp__Claude_Code_Remote__subscribe_pr_activity",
      "mcp__Claude_Code_Remote__unsubscribe_pr_activity"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "CONFIG=.claude/gas-dispatcher.local.json; [ -f \"$CONFIG\" ] || CONFIG=.claude/gas-dispatcher.json; if [ -f \"$CONFIG\" ]; then export GAS_DISPATCHER_URL=$(jq -r .url \"$CONFIG\" 2>/dev/null); export GAS_DISPATCHER_TOKEN=$(jq -r .token \"$CONFIG\" 2>/dev/null); echo \"[gas-dispatcher] loaded from $CONFIG url=${GAS_DISPATCHER_URL:0:40}...\"; else echo \"[gas-dispatcher] no config found (.claude/gas-dispatcher.json or .local.json). See docs/guide/02-setup.md\"; fi"
          },
          {
            "type": "command",
            "command": "[ -f scripts/sync-bound-scripts.sh ] && bash scripts/sync-bound-scripts.sh 2>&1 || true"
          }
        ]
      }
    ]
  }
}
